# =============================================================================
# TUSA GATO'S 24/7 - ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# AI / LLM APIs
# -----------------------------------------------------------------------------

# OpenRouter API Key (for LLM fallback/enhancement)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# Optional RetellAI LLM routing (ex: openrouter + model)
RETELL_LLM_PROVIDER=openrouter
RETELL_LLM_MODEL=google/gemini-2.0-flash

# RetellAI API Key (AI Voice Receptionist)
RETELL_API_KEY=key_your_retell_api_key
RETELL_AGENT_ID=agent_your_retell_agent_id
RETELL_WEBHOOK_SECRET=whsec_your_retell_webhook_secret

# Google Gemini (optional enhancement)
# GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# CONVEX DATABASE
# -----------------------------------------------------------------------------

# Convex deployment URL (get this from `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION
# -----------------------------------------------------------------------------

# FastAPI Backend
API_PORT=8000
API_HOST=0.0.0.0
API_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------

# Next.js Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# NOTIFICATION SERVICES
# -----------------------------------------------------------------------------

# Twilio (for SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1888TUSAGATO

# SendGrid / Email
# SENDGRID_API_KEY=your_sendgrid_api_key
# FROM_EMAIL=noreply@tusagatos247.com
# FROM_NAME="Tusa Gato's 24/7"

# -----------------------------------------------------------------------------
# VERCEL DEPLOYMENT (for production)
# -----------------------------------------------------------------------------

# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id

# =============================================================================
# INSTRUCTIONS:
# =============================================================================
# 1. Copy this file to .env.local for local development
# 2. Update CONVEX_DEPLOYMENT after running `npx convex dev`
# 3. Add Twilio/SendGrid keys when ready for notifications
# 4. Never commit .env files with real secrets to git
# =============================================================================
